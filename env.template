# Database Configuration
# PostgreSQL akan dibuat otomatis oleh docker-compose.yml
# DATABASE_URL akan otomatis dibuat dari POSTGRES_* variables di bawah

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=isp_app
POSTGRES_PORT=5432

# DATABASE_URL (otomatis dibuat dari POSTGRES_* variables di docker-compose.yml)
# Tidak perlu diisi manual jika menggunakan PostgreSQL dari docker-compose.yml
# DATABASE_URL=postgresql://postgres:password@postgres:5432/isp_app?schema=public

# Application Port
APP_PORT=3000
NODE_ENV=production

# Xendit Payment Gateway
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token_here

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SMTP Configuration (for email reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# EvolutionAPI Configuration
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=ubah-saya
EVOLUTION_INSTANCE_NAME=isp-app
